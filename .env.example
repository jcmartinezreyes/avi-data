# Copia este archivo como .env y sustituye los valores de ejemplo.
# Exporta las variables antes de ejecutar Streamlit. La app lee el entorno del proceso.
# En zsh/bash: set -a; source .env; set +a
# Usa la clave publicable del proyecto, nunca una clave secret o service_role.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica_aqui
